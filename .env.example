# 对话模型。URL 必须是完整接口地址。
CHAT_URL=https://api.deepseek.com/chat/completions
CHAT_API_KEY=your-chat-api-key
CHAT_CHANNEL=deepseek-chat
CHAT_TIMEOUT=60

# BOCAI OpenAI 风格对话接口，示例：
# CHAT_URL=https://your-host/bocai-chat/mtp/v1/chat/completions
# CHAT_API_KEY=your-chat-channel-api-key
# CHAT_CHANNEL=llm-chat-core

# 向量化模型。local 使用本地 BGE，bocai 使用独立业务接口。
EMBEDDING_PROVIDER=local
EMBEDDING_BATCH_SIZE=32
EMBEDDING_NORMALIZE=true

# local 模式使用。默认保留 BGE 的查询 instruction。
# EMBEDDING_LOCAL_MODEL=./models/bge-small-zh-v1.5
# EMBEDDING_DIM=512
# EMBEDDING_QUERY_PREFIX=为这个句子生成表示以用于检索相关文章：
# EMBEDDING_DOCUMENT_PREFIX=

# BOCAI 向量化接口示例：
# EMBEDDING_PROVIDER=bocai
# EMBEDDING_URL=https://your-host/bocai-chat/agent/v1/embeddings
# EMBEDDING_API_KEY=your-embedding-channel-api-key
# EMBEDDING_CHANNEL=embedding
# EMBEDDING_DIM=1024

# 精排模型。local 使用本地 CrossEncoder，bocai 使用独立业务接口。
RERANK_PROVIDER=local
RERANK_MAX_LENGTH=512
RERANK_TIMEOUT=60

# BOCAI 精排接口示例：
# RERANK_PROVIDER=bocai
# RERANK_URL=https://your-host/bocai-chat/agent/v1/rerank
# RERANK_API_KEY=your-rerank-channel-api-key
# RERANK_CHANNEL=rerank
